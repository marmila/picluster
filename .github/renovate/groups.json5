{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": ["Actions Runner Controller Group"],
      "groupName": "Actions Runner Controller",
      "matchPackagePatterns": [
        "gha-runner-scale-set-controller",
        "gha-runner-scale-set"
      ],
      "matchDatasources": ["helm", "docker"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Flux Group"],
      "groupName": "Flux",
      "matchPackagePatterns": ["fluxcd"],
      "matchDatasources": ["docker", "helm", "github-tags"],
      "versioning": "semver",
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["Schema Registry Group"],
      "groupName": "Schema-Registry",
      "matchPackagePatterns": ["schema-registry"],
      "matchDatasources": ["helm"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": true
    },
    {
      "description": ["System Upgrade Controller Group"],
      "groupName": "System Upgrade Controller",
      "matchPackagePatterns": ["system-upgrade-controller"],
      "matchDatasources": ["docker", "github-releases"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "separateMinorPatch": true
    },
    // Same tool pinned in several places (mise, Dockerfiles, helmfile, ansible):
    // one PR per version bump instead of one per file.
    {
      "description": ["Cilium Group"],
      "groupName": "Cilium",
      "matchDepNames": ["cilium", "quay.io/cilium/charts/cilium"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Helm CLI Group"],
      "groupName": "Helm CLI",
      "matchDepNames": ["helm", "helm/helm", "alpine/helm"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      // Not just the CLI: fluxcd/flux2 is also the Flux version the cluster runs
      // (flux-operator instance values) and the bootstrap version (ansible vars).
      "description": ["Flux distribution Group: upgrades Flux in the cluster"],
      "groupName": "Flux distribution",
      "matchDepNames": ["flux2", "fluxcd/flux2"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["kubectl Group"],
      "groupName": "kubectl",
      "matchDepNames": ["kubectl", "alpine/kubectl"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Velero CLI Group"],
      "groupName": "Velero CLI",
      "matchDepNames": ["velero", "vmware-tanzu/velero"],
      // Exclude the velero Helm chart, which has its own version line
      "matchDatasources": ["!helm"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Prometheus Operator CRDs Group"],
      "groupName": "Prometheus Operator CRDs",
      "matchDepNames": [
        "prometheus-operator-crd",
        "ghcr.io/prometheus-community/charts/prometheus-operator-crds"
      ],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    // Critical infrastructure: kept out of the weekly "all non-major" bundle
    // so each one is upgraded (and can be rolled back) on its own.
    {
      "description": ["k3s: merging upgrades Kubernetes on every node via system-upgrade-controller"],
      "groupName": "k3s",
      "matchDepNames": ["k3s-io/k3s"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Longhorn Group"],
      "groupName": "Longhorn",
      "matchDepNames": ["longhorn", "longhorn/longhorn"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Istio Group (release version)"],
      "groupName": "Istio",
      "matchDepNames": ["istio/istio"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Istio Group (Helm charts: base, cni, istiod, ztunnel)"],
      "groupName": "Istio",
      // Chart names are generic, so only match them inside the istio app
      "matchDepNames": ["base", "cni", "istiod", "ztunnel"],
      "matchFileNames": ["kubernetes/platform/istio/**"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["CloudNativePG Group"],
      "groupName": "CloudNativePG",
      "matchDepNames": ["cloudnative-pg"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    },
    {
      "description": ["Vault Group"],
      "groupName": "Vault",
      "matchDepNames": ["vault", "hashicorp/vault"],
      "group": { "commitMessageTopic": "{{{groupName}}} group" }
    }
  ]
}