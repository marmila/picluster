{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Extended BEFORE groups.json5, so the named groups there take precedence
  // over the weekly catch-all group below. groups.json5 only sets group names,
  // so the automerge settings here apply to the groups too.
  //
  // Automerge policy (homelab-docs/update-automation.md):
  //   - Renovate merges only when every check passes (Validate Kubernetes, Lint, ...)
  //   - only on weekdays 10:00-18:00 Europe/Rome, so someone can react
  //   - critical components one per weekday; k3s, Longhorn, Cilium, Flux,
  //     system-upgrade-controller, majors and blocked packages stay manual
  timezone: "Europe/Rome",
  automergeSchedule: ["* 10-17 * * 1-5"],
  // Renovate merges itself (instead of GitHub auto-merge), so the time window
  // and the check results are always respected.
  platformAutomerge: false,
  // Registries such as ghcr.io and quay.io publish no release dates. Since Renovate 42
  // an undated release otherwise waits forever on minimumReleaseAge ("Pending Status
  // Checks", renovate/stability-days). Undated releases are taken without the wait;
  // the critical automerged components below require a date (timestamp-required).
  minimumReleaseAgeBehaviour: "timestamp-optional",
  packageRules: [
    {
      description: "Bundle all non-major updates into one weekly PR, automerged on Monday",
      matchUpdateTypes: ["minor", "patch", "digest"],
      // Blocked packages (see "Blocked packages" rule) stay out of the bundle.
      // Keep this list in sync with that rule.
      matchDepNames: ["!ubuntu", "!elastic/elasticsearch", "!python"],
      groupName: "all non-major",
      group: {
        commitMessageTopic: "{{{groupName}}} dependencies",
      },
      schedule: ["before 6am on monday"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      automergeSchedule: ["* 10-17 * * 1"],
    },
    {
      description: "Automerge workstation tools (mise) and GitHub Actions",
      matchManagers: ["mise", "github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      groupName: "tooling",
      automerge: true,
      automergeType: "branch",
    },
    {
      description: "Automerge CLI tool groups (mise, runner Dockerfile, Ansible CLI versions): no cluster change",
      matchDepNames: ["kubectl", "alpine/kubectl", "helm", "helm/helm", "alpine/helm", "velero", "vmware-tanzu/velero"],
      // not the velero Helm chart, which deploys Velero in the cluster (weekly bundle)
      matchDatasources: ["!helm"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Automerge Grafana dashboard revisions",
      matchDatasources: ["custom.grafana-dashboards"],
      automerge: true,
      automergeType: "branch",
    },

    // Critical components: automerged one per weekday, only releases at least
    // 7 days old. A failed Helm upgrade is rolled back by Flux (upgrade.remediation).
    {
      description: "Vault: automerge on Tuesday",
      matchDepNames: ["vault", "hashicorp/vault"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "7 days",
      minimumReleaseAgeBehaviour: "timestamp-required",
      automergeSchedule: ["* 10-17 * * 2"],
    },
    {
      description: "CloudNativePG: automerge on Wednesday",
      matchDepNames: ["cloudnative-pg"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "7 days",
      minimumReleaseAgeBehaviour: "timestamp-required",
      automergeSchedule: ["* 10-17 * * 3"],
    },
    {
      description: "Istio: automerge on Thursday",
      matchDepNames: ["istio/istio"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "7 days",
      minimumReleaseAgeBehaviour: "timestamp-required",
      automergeSchedule: ["* 10-17 * * 4"],
    },
    {
      description: "Istio Helm charts: automerge on Thursday (same group as istio/istio)",
      matchDepNames: ["base", "cni", "istiod", "ztunnel"],
      matchFileNames: ["kubernetes/platform/istio/**"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      minimumReleaseAge: "7 days",
      minimumReleaseAgeBehaviour: "timestamp-required",
      automergeSchedule: ["* 10-17 * * 4"],
    },
    {
      description: "Cilium: manual. Its chart comes from quay.io, which publishes no release dates, so the 7-day wait cannot be enforced",
      matchDepNames: ["cilium", "quay.io/cilium/charts/cilium"],
      automerge: false,
    },

    {
      description: "Manual: cannot be rolled back, or a failure stops Flux itself",
      // k3s and Longhorn do not support downgrades. Flux (operator, instance and
      // distribution): if it breaks, Flux cannot roll anything back, itself included.
      // system-upgrade-controller runs the k3s node upgrades.
      matchDepNames: [
        "k3s-io/k3s",
        "longhorn", "longhorn/longhorn",
        "fluxcd/flux2", "flux2",
        "rancher/system-upgrade-controller",
      ],
      automerge: false,
    },
    {
      description: "Manual: Flux operator and instance charts",
      matchPackageNames: ["/controlplaneio-fluxcd/"],
      automerge: false,
    },
    {
      description: "Blocked packages: own PRs, never grouped or automerged",
      // Add a package here (and to the negated list above) to block it.
      // python: runner image is python:3.14-slim; 3.15 bump was reverted upstream (bceb9cd9).
      matchDepNames: ["ubuntu", "elastic/elasticsearch", "python"],
      automerge: false,
      addLabels: ["blocked"],
    },
    {
      description: "mongo client image (mongosh) must stay on the MongoDB server line",
      // Server version is set in kubernetes/apps/e-commerce/config/databases/base/mongodb-community.yaml
      // (8.0.x, not tracked by Renovate). Raise this cap when the server is upgraded.
      matchDepNames: ["mongo"],
      allowedVersions: "<8.1",
    },
    {
      description: "ansible-core must stay within what the prometheus.prometheus collection supports",
      // prometheus.prometheus 0.30.x requires ansible-core <=2.21.99, so 2.22 breaks the runner image build
      // (ansible-galaxy collection install). Raise this cap when a collection release supports the next version.
      matchDepNames: ["ansible-core"],
      allowedVersions: "<2.22",
    },
  ],
}
