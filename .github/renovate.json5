{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    'github>marmila/picluster//.github/renovate/clusters.json5',
    'github>marmila/picluster//.github/renovate/customManagers.json5',
    'github>marmila/picluster//.github/renovate/grafanaDashboards.json5',
    'github>marmila/picluster//.github/renovate/automerge.json5',
    'github>marmila/picluster//.github/renovate/groups.json5',
    'github>marmila/picluster//.github/renovate/labels.json5',
  ],
  dependencyDashboardTitle: 'Renovate Dashboard 🤖',
  // Grouping keeps the PR count low; the default cap of 10 was blocking new PRs
  prConcurrentLimit: 20,
  flux: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  helmfile: {
    managerFilePatterns: [
      '/(^|/)helmfile\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/(^|/)kubernetes/.+\\.ya?ml$/',
    ],
  },
  kustomize: {
    managerFilePatterns: [
      '/(^|/)kustomization\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  pip_requirements: {
    managerFilePatterns: [
      '/(^|/)[\\w-]*requirements(-\\w+)?\\.(txt|pip)(?:\\.j2)?$/',
    ],
  },
  ansible: {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  'ansible-galaxy': {
    managerFilePatterns: [
      '/(^|/)ansible/.+\\.ya?ml(?:\\.j2)?$/',
    ],
  },
  // Dependencies of the k3s-mixins build
  // (kubernetes/platform/kube-prometheus-stack/k3s-mixins/build/src/jsonnetfile.json).
  packageRules: [
    {
      description: 'kubernetes-mixin is pinned to a commit and tracked by the git-refs custom manager, not by tags',
      matchManagers: ['jsonnet-bundler'],
      matchPackageNames: ['https://github.com/kubernetes-sigs/kubernetes-mixin.git'],
      enabled: false,
    },
    {
      description: 'kube-prometheus publishes v-prefixed semver tags',
      matchManagers: ['jsonnet-bundler'],
      matchPackageNames: ['https://github.com/prometheus-operator/kube-prometheus.git'],
      versioning: 'semver-coerced',
    },
    {
      // From upstream 824913332. elastic/elasticsearch and mongo are also capped in
      // renovate/automerge.json5; this makes the intent explicit for all three.
      description: 'ES 9, cp-schema-registry 8 and MongoDB 9 change on-disk or wire formats: they need a migration plan and an e2e window, not a rolling upgrade',
      matchPackageNames: [
        'elastic/elasticsearch',
        'docker.io/confluentinc/cp-schema-registry',
        '/^(docker\\.io\\/library\\/)?mongo$/',
      ],
      matchUpdateTypes: ['major'],
      enabled: false,
    },
  ],
}
